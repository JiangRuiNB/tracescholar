# Runtime
TRACESCHOLAR_APP_ENV=development
TRACESCHOLAR_LOG_LEVEL=INFO
TRACESCHOLAR_DATA_DIR=data

# Database
TRACESCHOLAR_DATABASE_URL=postgresql+psycopg://tracescholar:tracescholar@localhost:5432/tracescholar

# Official OpenAI fallback (optional when using a compatible provider)
TRACESCHOLAR_OPENAI_API_KEY=
TRACESCHOLAR_OPENAI_MODEL=gpt-5.6-terra

# LLM gateway (set these to your OpenAI-compatible provider; never commit keys)
TRACESCHOLAR_LLM_BASE_URL=https://api.openai.com/v1
TRACESCHOLAR_LLM_API_KEY=
TRACESCHOLAR_LLM_MODEL=
TRACESCHOLAR_LLM_STRUCTURED_MODE=json_schema
TRACESCHOLAR_LLM_TIMEOUT_SECONDS=60
TRACESCHOLAR_FULLTEXT_SCREENING_LLM_TIMEOUT_SECONDS=180
TRACESCHOLAR_EVIDENCE_LLM_TIMEOUT_SECONDS=120
TRACESCHOLAR_SYNTHESIS_LLM_TIMEOUT_SECONDS=180

# OpenAlex (a key is recommended for regular use)
TRACESCHOLAR_OPENALEX_BASE_URL=https://api.openalex.org
TRACESCHOLAR_OPENALEX_API_KEY=
TRACESCHOLAR_OPENALEX_TIMEOUT_SECONDS=30

# Crossref (email is optional but recommended for the polite pool)
TRACESCHOLAR_CROSSREF_BASE_URL=https://api.crossref.org
TRACESCHOLAR_CROSSREF_EMAIL=
TRACESCHOLAR_CROSSREF_TIMEOUT_SECONDS=30

# Open-access PDF acquisition
TRACESCHOLAR_FULLTEXT_TIMEOUT_SECONDS=30
TRACESCHOLAR_FULLTEXT_MAX_BYTES=20000000
TRACESCHOLAR_FULLTEXT_UNAVAILABLE_RETRY_HOURS=24

# Separate OpenAI-compatible cloud Embeddings endpoint; do not commit its key
TRACESCHOLAR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRACESCHOLAR_EMBEDDING_API_KEY=
TRACESCHOLAR_EMBEDDING_MODEL=qwen3.7-text-embedding
TRACESCHOLAR_EMBEDDING_MODEL_VERSION=
TRACESCHOLAR_EMBEDDING_DIMENSIONS=1024
TRACESCHOLAR_EMBEDDING_BATCH_SIZE=20
TRACESCHOLAR_EMBEDDING_TIMEOUT_SECONDS=60
